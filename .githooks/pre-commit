#!/bin/bash
# Pre-commit hook for pyx
# Runs formatter and linter on staged Rust files, tests only when source changes

set -e

# Get staged files (Added, Copied, Modified)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
STAGED_RS=$(echo "$STAGED_FILES" | grep -E '\.rs$' || true)

# Skip if no Rust files staged
if [ -z "$STAGED_RS" ]; then
    echo "No Rust files staged, skipping pre-commit checks."
    exit 0
fi

# Count staged Rust files
RS_COUNT=$(echo "$STAGED_RS" | wc -l)
echo "Running pre-commit checks on $RS_COUNT Rust file(s)..."
echo ""

# Check formatting
echo "Checking formatting..."
if ! cargo fmt -- --check; then
    echo ""
    echo "Format check failed. Run 'cargo fmt' to fix."
    exit 1
fi

# Run linter
echo ""
echo "Running linter..."
if ! cargo clippy -- -D warnings; then
    echo ""
    echo "Lint check failed. Fix the issues above."
    exit 1
fi

# Run tests only if source files changed (not just tests)
if echo "$STAGED_RS" | grep -q '^src/'; then
    echo ""
    echo "Source files changed, running unit tests..."
    if ! cargo test --lib; then
        echo ""
        echo "Tests failed. Fix the issues above."
        exit 1
    fi
fi

echo ""
echo "All pre-commit checks passed!"
exit 0
